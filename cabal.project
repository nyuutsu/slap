packages: .

-- tasty-stats and encoding cap dependencies below the versions we build against; both build fine past those caps, so relax them here.
allow-newer:
    tasty-stats:*
  , encoding:containers

-- Everyday builds iterate at -O0; `make optimized` asks for -O2, which cabal keeps in its own output directory.
optimization: 0

-- Info-table provenance, so backtraces name real constructors.
package slap
  ghc-options: -finfo-table-map -fdistinct-constructor-tables

-- One shared job pool for the whole build, sized to the machine's cores, so the big library stops compiling on a single core.
semaphore: True
