packages: .

-- tasty-stats and encoding cap dependencies below the versions we build against; both build fine past those caps, so relax them here.
allow-newer:
    tasty-stats:*
  , encoding:containers

-- slap's job is crunching bytes, so there is one flavor and it is the fast one.
optimization: 2

-- Compiled section by section, so the linker can drop whatever nothing reaches; darwin has no use for this and ignores it.
package *
  ghc-options: -split-sections

-- One shared job pool for the whole build, sized to the machine's cores, so the big library stops compiling on a single core.
semaphore: True
