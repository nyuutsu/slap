packages: .

-- Two dependencies ship stale upper bounds that are ecosystem rot rather
-- than real breakage; wave the offending caps through.
--
-- tasty-stats 0.2.0.4 caps tasty < 1.2, containers < 0.6, directory < 1.4,
-- stm < 2.6, tagged < 0.9, time < 1.9 -- its API is unchanged against the
-- current versions of all of them.
--
-- encoding caps containers < 0.8, but GHC 9.14 bundles containers 0.8.
-- This is a no-op before 9.14, where the bundled containers is still 0.7.
allow-newer:
    tasty-stats:tasty
  , tasty-stats:containers
  , tasty-stats:directory
  , tasty-stats:stm
  , tasty-stats:tagged
  , tasty-stats:time
  , encoding:containers
