                  , Props.Undo
                  , Props.Verify
                  , Props.Web
                  , Props.XDelta1Conformance
  hs-source-dirs:   test
  ghc-options:      -threaded -rtsopts "-with-rtsopts=-N"
  build-depends:
      aeson                >= 2.1  && < 2.3
    , array                >= 0.5
    , bytestring           >= 0.11
    , encoding             >= 0.10 && < 0.11
    , tasty                >= 1.4  && < 1.6
    , tasty-quickcheck     >= 0.10 && < 0.12
    , tasty-hunit          >= 0.10 && < 0.11
    , slap:slap-internal
    , slap:slap-web
    , containers           >= 0.6
    , text                 >= 2.0
    , vector               >= 0.13 && < 0.14

