cabal-version: 3.0
name:          slap
version:       0.1.0.0
synopsis:      Multi-format ROM patching tool
description:
  Auto-detects patch format from magic bytes and applies.  Supports
  PPF (1/2/3 + "4"/Pyriel internal), IPS (standard/IPS32/EBP), BPS, UPS,
  VCDIFF/xdelta3, APS (N64/GBA), RUP/NINJA2, NINJA1 (binary/text/gzip),
  DPS, BSDiff/BDF, GDIFF, xdelta1, and PMSR (with Yay0 decompression
  for Star Rod .mod files).  Can create BPS, IPS, IPS32, EBP, UPS,
  PPF3, PMSR, NINJA1, DPS, RUP, APS (N64/GBA), and GDIFF patches.
  Converts between formats with the convert command.  Transparently
  unwraps ZIP/RAR/7z archives containing patches.

license:       MIT
license-file:  LICENSE
author:        nyuu
build-type:    Simple

library slap-internal
  exposed-modules:
      Patch.Archive
    , Patch.APS
    , Patch.Binary
    , Patch.BPS
    , Patch.DPS
    , Patch.Format
    , Patch.NINJA1
    , Patch.Get
    , Patch.BSDiff
    , Patch.Detect
    , Patch.Explain
    , Patch.GDIFF
    , Patch.IPS
    , Patch.PMSR
    , Patch.RUP
    , Patch.Types
    , Patch.UPS
    , Patch.VCDIFF
    , Patch.XDelta1
    , Patch.Yay0
    , Patch.PPF.Apply
    , Patch.PPF.Create
    , Patch.PPF.Info
    , Patch.PPF.Parse
    , Patch.PPF.Types
  hs-source-dirs:   src
  default-language: GHC2024
  ghc-options:      -Wall -O2
  build-depends:
      base                 >= 4.18 && < 5
    , array                >= 0.5
    , bytestring           >= 0.11
    , containers           >= 0.6
    , directory             >= 1.3
    , filepath             >= 1.4
    , process              >= 1.6
    , bzlib                >= 0.5
    , zlib                 >= 0.6

executable slap
  main-is:          Main.hs
  hs-source-dirs:   app
  default-language: GHC2024
  ghc-options:      -Wall -O2
  build-depends:
      base                 >= 4.18 && < 5
    , bytestring           >= 0.11
    , directory             >= 1.3
    , filepath             >= 1.4
    , optparse-applicative  >= 0.16
    , slap:slap-internal

test-suite props
  type:             exitcode-stdio-1.0
  main-is:          Props.hs
  hs-source-dirs:   test
  default-language: GHC2024
  ghc-options:      -Wall
  build-depends:
      base                 >= 4.18 && < 5
    , bytestring           >= 0.11
    , directory             >= 1.3
    , tasty                >= 1.4
    , tasty-quickcheck     >= 0.10
    , QuickCheck           >= 2.14
    , slap:slap-internal
