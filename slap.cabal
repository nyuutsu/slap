cabal-version: 3.0
name:          slap
version:       0.1.0.0
synopsis:      Multi-format ROM patching tool
description:
  Auto-detects patch format from magic bytes and applies.  Supports
  PPF (1/2/3 + Pyriel internal), IPS (standard/IPS32/EBP), BPS, UPS,
  VCDIFF/xdelta3, APS (N64/GBA), RUP/NINJA2, BSDiff, GDIFF, and
  xdelta1.

license:       MIT
license-file:  LICENSE
author:        nyuu
build-type:    Simple

flag bsdiff
  description: Native BSDiff support via bzlib (requires libbz2)
  default:     True
  manual:      True

executable slap
  main-is:          Main.hs
  hs-source-dirs:   src
  default-language: GHC2024
  ghc-options:      -Wall -O2
  other-modules:
      Patch.APS
    , Patch.Binary
    , Patch.BPS
    , Patch.Format
    , Patch.BSDiff
    , Patch.Detect
    , Patch.Explain
    , Patch.GDIFF
    , Patch.IPS
    , Patch.RUP
    , Patch.Types
    , Patch.UPS
    , Patch.VCDIFF
    , Patch.XDelta1
    , Patch.PPF.Apply
    , Patch.PPF.Create
    , Patch.PPF.Info
    , Patch.PPF.Parse
    , Patch.PPF.Types
  build-depends:
      base                 >= 4.18 && < 5
    , array                >= 0.5
    , bytestring           >= 0.11
    , directory             >= 1.3
    , optparse-applicative  >= 0.16
    , process              >= 1.6
    , zlib                 >= 0.6

  if flag(bsdiff)
    build-depends: bzlib >= 0.5
    cpp-options:   -DBSDIFF_NATIVE
