cabal-version: 3.0
name:          slap
version:       0.1.0.0
synopsis:      Multi-format ROM patching tool
description:
  Auto-detects patch format from magic bytes and applies.  Supports
  PPF, IPS (including IPS32 and EBP), BPS, UPS, and VCDIFF/xdelta3.

license:       MIT
license-file:  LICENSE
author:        nyuu
build-type:    Simple

executable slap
  main-is:          Main.hs
  hs-source-dirs:   src
  default-language: GHC2024
  ghc-options:      -Wall -O2
  other-modules:
      Patch.Binary
    , Patch.BPS
    , Patch.Detect
    , Patch.IPS
    , Patch.Types
    , Patch.UPS
    , Patch.VCDIFF
    , Patch.PPF.Apply
    , Patch.PPF.Create
    , Patch.PPF.Info
    , Patch.PPF.Parse
    , Patch.PPF.Types
  build-depends:
      base                 >= 4.18 && < 5
    , array                >= 0.5
    , bytestring           >= 0.11
    , directory             >= 1.3
    , optparse-applicative  >= 0.16
