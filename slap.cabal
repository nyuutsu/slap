cabal-version: 3.0
name:          slap
version:       0.1.0.0
synopsis:      Multi-format ROM patching tool
description:
  Apply, create, and convert ROM patches.
  See README for the full list.

license:       MIT
license-file:  LICENSE
author:        nyuu
build-type:    Simple
tested-with:   GHC == 9.10.*, GHC == 9.12.*, GHC == 9.14.*

library slap-internal
  exposed-modules:
      Slap.Archive
    , Slap.Archive.Types
    , Slap.Archive.Zip
    , Slap.APSN64.Apply
    , Slap.Checksum
    , Slap.APSN64.Create
    , Slap.APSN64.Describe
    , Slap.APSN64.Parse
    , Slap.APSN64.Types
    , Slap.APSGBA.Apply
    , Slap.APSGBA.Create
    , Slap.APSGBA.Describe
    , Slap.APSGBA.Parse
    , Slap.APSGBA.Types
    , Slap.Binary
    , Slap.BPS.Apply
    , Slap.BPS.Create
    , Slap.BPS.Describe
    , Slap.BPS.FFI
    , Slap.BPS.Parse
    , Slap.BPS.Types
    , Slap.Compression.Stream
    , Slap.Compression.Yay0
    , Slap.FFI
    , Slap.DPS.Apply
    , Slap.DPS.Create
    , Slap.DPS.Describe
    , Slap.DPS.Parse
    , Slap.DPS.Types
    , Slap.Display.Primitives
    , Slap.Display.Glyph
    , Slap.FormatLabel
    , Slap.FieldName
    , Slap.NINJA1.Apply
    , Slap.NINJA1.Create
    , Slap.NINJA1.Describe
    , Slap.NINJA1.Parse
    , Slap.NINJA1.Types
    , Slap.ByteParser
    , Slap.PatchField
    , Slap.BSDiff.Apply
    , Slap.BSDiff.Describe
    , Slap.BSDiff.Parse
    , Slap.BSDiff.Types
    , Slap.Detect
    , Slap.Display.Analysis
    , Slap.Display.Common
    , Slap.Display.Info
    , Slap.FileContents
    , Slap.Status
    , Slap.GDIFF.Apply
    , Slap.GDIFF.Create
    , Slap.GDIFF.Describe
    , Slap.GDIFF.Parse
    , Slap.GDIFF.Types
    , Slap.JSON
    , Slap.IPS.Apply
    , Slap.IPS.Create
    , Slap.IPS.Describe
    , Slap.IPS.Optimize
    , Slap.IPS.Parse
    , Slap.IPS.Types
    , Slap.Measure
    , Slap.Narrow
    , Slap.MetadataField
    , Slap.MetadataInclusion
    , Slap.Constraint
    , Slap.Dialect
    , Slap.Convert
    , Slap.Create
    , Slap.Platform
    , Slap.PlatformType
    , Slap.PMSR.Apply
    , Slap.PMSR.Create
    , Slap.PMSR.Describe
    , Slap.PMSR.Parse
    , Slap.PMSR.Types
    , Slap.NINJA2.Apply
    , Slap.NINJA2.Create
    , Slap.NINJA2.Describe
    , Slap.NINJA2.Parse
    , Slap.NINJA2.Types
    , Slap.SomePatch
    , Slap.Text
    , Slap.PatchFormat
    , Slap.UPS.Apply
    , Slap.UPS.Create
    , Slap.UPS.Describe
    , Slap.UPS.Parse
    , Slap.UPS.Types
    , Slap.VCDIFF.CodeTable
    , Slap.VCDIFF.Types
    , Slap.VCDIFF.Parse
    , Slap.VCDIFF.Apply
    , Slap.XDelta1.Apply
    , Slap.XDelta1.Create
    , Slap.XDelta1.Describe
    , Slap.XDelta1.FFI
    , Slap.XDelta1.Parse
    , Slap.XDelta1.Types
    , Slap.PPF1.Apply
    , Slap.PPF1.Create
    , Slap.PPF1.Describe
    , Slap.PPF1.Parse
    , Slap.PPF1.Types
    , Slap.PPF2.Apply
    , Slap.PPF2.Create
    , Slap.PPF2.Describe
    , Slap.PPF2.Parse
    , Slap.PPF2.Types
    , Slap.PPF3.Apply
    , Slap.PPF3.Create
    , Slap.PPF3.Describe
    , Slap.PPF3.Parse
    , Slap.PPF3.Types
    , Slap.PPF4.Apply
    , Slap.PPF4.Create
    , Slap.PPF4.Describe
    , Slap.PPF4.Parse
    , Slap.PPF4.Types
  hs-source-dirs:   src
  default-language: GHC2024
  ghc-options:      -Wall -Werror -Wname-shadowing -O2 -g3
  extra-libraries:  rusty_slap
  build-depends:
      base                 >= 4.20 && < 5
    , aeson                >= 2.0  && < 2.3
    , array                >= 0.5
    , bytestring           >= 0.11
    , containers           >= 0.6
    , directory            >= 1.3
    , encoding             >= 0.10 && < 0.11
    , filepath             >= 1.4
    , process              >= 1.6
    , crypton              >= 0.31 && < 1.2
    , ram                  >= 0.21 && < 0.23
    , text                 >= 2.0
    , transformers         >= 0.5
    , vector               >= 0.13 && < 0.14
    , vector-algorithms    >= 0.9  && < 0.10

executable slap
  main-is:          Main.hs
  hs-source-dirs:   app
  default-language: GHC2024
  ghc-options:      -Wall -Werror -Wpartial-fields -Wname-shadowing -O2 -g3
  build-depends:
      base                 >= 4.20 && < 5
    , bytestring           >= 0.11
    , containers           >= 0.6
    , directory            >= 1.3
    , filepath             >= 1.4
    , optparse-applicative  >= 0.16 && < 0.20
    , slap:slap-internal
    , text                 >= 2.0

test-suite props
  type:             exitcode-stdio-1.0
  main-is:          Props.hs
  other-modules:    Props.BPSMetadata
                  , Props.ClassifyTargetCopy
                  , Props.Contracts
                  , Props.Detection
                  , Props.Helpers
                  , Props.Identity
                  , Props.IPSMarkerPolicy
                  , Props.JSON
                  , Props.Narrow
                  , Props.ParseWarnings
                  , Props.ResolveCopyAddress
                  , Props.RoundTrip
                  , Props.SpecConformance
                  , Props.Text
                  , Props.Truncation
                  , Props.Undo
                  , Props.XDelta1Conformance
  hs-source-dirs:   test
  default-language: GHC2024
  ghc-options:      -Wall -Werror -Wname-shadowing -threaded -rtsopts "-with-rtsopts=-N"
  build-depends:
      base                 >= 4.20 && < 5
    , bytestring           >= 0.11
    , directory            >= 1.3
    , encoding             >= 0.10 && < 0.11
    , tasty                >= 1.4  && < 1.6
    , tasty-quickcheck     >= 0.10 && < 0.12
    , tasty-hunit          >= 0.10 && < 0.11
    , slap:slap-internal
    , containers           >= 0.6
    , crypton              >= 0.31 && < 1.2
    , ram                  >= 0.21 && < 0.23
    , text                 >= 2.0
    , vector               >= 0.13 && < 0.14

test-suite integration
  type:             exitcode-stdio-1.0
  main-is:          Integration.hs
  hs-source-dirs:   test
  other-modules:    Integration.Helpers
                  , Integration.External
                  , Integration.Skip
                  , Integration.HeavyTests
                  , Integration.Bootstrap
                  , Integration.Runner
                  , Integration.Apply
                  , Integration.Create
                  , Integration.CrossVal
                  , Integration.Convert
                  , Integration.Metadata
                  , Integration.Undo
                  , Integration.CLI
                  , Integration.FailureMode
                  , Integration.VCDIFFApply
                  , Integration.XDelta1Names
  default-language: GHC2024
  ghc-options:      -Wall -Werror -Wname-shadowing -threaded -rtsopts "-with-rtsopts=-N"
  build-depends:
      base          >= 4.20 && < 5
    , bytestring    >= 0.11
    , containers    >= 0.6
    , directory     >= 1.3
    , filepath      >= 1.4
    , process       >= 1.6
    , temporary     >= 1.3  && < 1.4
    , tasty         >= 1.4  && < 1.6
    , tasty-hunit   >= 0.10 && < 0.11
    , tasty-stats   >= 0.2  && < 0.3
    , text          >= 2.0
    , time          >= 1.12
    , mmap          >= 0.5  && < 0.6
    , slap:slap-internal

