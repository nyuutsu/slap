cabal-version: 3.0
name:          slap
version:       1.0.0
synopsis:      Multi-format ROM patching tool
description:
  slap applies, creates, examines, and converts ROM patches in several formats:
  APS-GBA, APS-N64, BPS, BSDiff, DPS, EBP, GDIFF, IPS, IPS32, NINJA1, NINJA2, PMSR, (🏃💦)
  PPF1, PPF2, PPF3, PPF4, UPS, VCDIFF (qua RFC 3284), xdelta1, and xdelta3.
  The patch format is detected automatically. Available as a command-line tool and as a website.

license:       MIT
license-file:  LICENSE
author:        nyuu
build-type:    Simple
tested-with:   GHC == 9.10.*, GHC == 9.12.*, GHC == 9.14.*

common shared
  default-language: GHC2024
  ghc-options:      -Wall -Werror -Wname-shadowing -Wincomplete-record-selectors
                    -Wcompat -Wredundant-constraints -Wmissing-export-lists -Woperator-whitespace
                    -Wunused-packages -Wredundant-bang-patterns -Widentities
  build-depends:    base >= 4.20 && < 5

