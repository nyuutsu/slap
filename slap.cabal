cabal-version: 3.0
name:          slap
version:       0.1.0.0
synopsis:      Multi-format ROM patching tool
description:
  Apply, create, and convert ROM patches.
  See README for the full list.

license:       MIT
license-file:  LICENSE
author:        nyuu
build-type:    Simple

library slap-internal
  exposed-modules:
      Patch.Archive
    , Patch.APS.N64
    , Patch.APS.GBA
    , Patch.Binary
    , Patch.BPS
    , Patch.Compress
    , Patch.FFI
    , Patch.DPS
    , Patch.Format
    , Patch.NINJA1
    , Patch.Get
    , Patch.BSDiff
    , Patch.Detect
    , Patch.Explain
    , Patch.GDIFF
    , Patch.IPS
    , Patch.Measure
    , Patch.Convert
    , Patch.PCHTXT
    , Patch.PMSR
    , Patch.RUP
    , Patch.SomePatch
    , Patch.Types
    , Patch.UPS
    , Patch.VCDIFF
    , Patch.XDelta1
    , Patch.Yay0
    , Patch.PPF.Apply
    , Patch.PPF.Create
    , Patch.PPF.Info
    , Patch.PPF.Parse
    , Patch.PPF.Types
  hs-source-dirs:   src
  default-language: GHC2024
  ghc-options:      -Wall -O2 -g3
  extra-libraries:  rusty_slap
  build-depends:
      base                 >= 4.18 && < 5
    , array                >= 0.5
    , bytestring           >= 0.11
    , containers           >= 0.6
    , directory             >= 1.3
    , filepath             >= 1.4
    , process              >= 1.6
    , crypton              >= 0.31
    , ram                  >= 0.21

executable slap
  main-is:          Main.hs
  hs-source-dirs:   app
  default-language: GHC2024
  ghc-options:      -Wall -O2 -g3
  build-depends:
      base                 >= 4.18 && < 5
    , bytestring           >= 0.11
    , directory             >= 1.3
    , filepath             >= 1.4
    , optparse-applicative  >= 0.16
    , slap:slap-internal

test-suite props
  type:             exitcode-stdio-1.0
  main-is:          Props.hs
  hs-source-dirs:   test
  default-language: GHC2024
  ghc-options:      -Wall -threaded -rtsopts "-with-rtsopts=-N"
  build-depends:
      base                 >= 4.18 && < 5
    , bytestring           >= 0.11
    , directory             >= 1.3
    , tasty                >= 1.4
    , tasty-quickcheck     >= 0.10
    , tasty-hunit          >= 0.10
    , QuickCheck           >= 2.14
    , slap:slap-internal
    , containers           >= 0.6
    , crypton              >= 0.31
    , ram                  >= 0.21

test-suite integration
  type:             exitcode-stdio-1.0
  main-is:          Integration.hs
  hs-source-dirs:   test
  other-modules:    Integration.Helpers
                  , Integration.Apply
                  , Integration.Create
                  , Integration.CrossVal
                  , Integration.Convert
                  , Integration.Metadata
                  , Integration.Undo
                  , Integration.CLI
                  , Integration.FailureMode
  default-language: GHC2024
  ghc-options:      -Wall -threaded -rtsopts "-with-rtsopts=-N"
  build-depends:
      base          >= 4.18 && < 5
    , bytestring    >= 0.11
    , containers    >= 0.6
    , directory     >= 1.3
    , filepath      >= 1.4
    , process       >= 1.6
    , temporary     >= 1.3
    , tasty         >= 1.4
    , tasty-hunit   >= 0.10
    , slap:slap-internal
