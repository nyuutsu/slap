library slap-web
  import:           shared
  exposed-modules:  Slap.Web
                  , Slap.Web.Declaration
                  , Slap.Web.Envelope
                  , Slap.Web.Vocabulary
  hs-source-dirs:   web
  build-depends:
      aeson                >= 2.1  && < 2.3
    , bytestring           >= 0.11
    , containers           >= 0.6
    , slap:slap-internal
    , text                 >= 2.0

-- The reactor over slap-web. Under wasm it is the browser-facing artifact: -no-hs-main, exports only.
-- Built natively it is the parity check's probe; Main.hs holds that story.
executable slap-web-reactor
  import:           shared
  main-is:          Main.hs
  hs-source-dirs:   web-reactor
  build-depends:
      aeson                >= 2.1  && < 2.3
    , bytestring           >= 0.11
    , slap:slap-internal
    , slap:slap-web
  if arch(wasm32)
    ghc-options: -no-hs-main "-optl-mexec-model=reactor"
                 "-optl-Wl,--export=hs_init" "-optl-Wl,--export=slap_web_link_check"
                 "-optl-Wl,--export=slap_web_alloc" "-optl-Wl,--export=slap_web_free"
                 "-optl-Wl,--export=slap_web_describe_surface"
                 "-optl-Wl,--export=slap_web_classify_dropped_file" "-optl-Wl,--export=slap_web_identify_patch"
                 "-optl-Wl,--export=slap_web_describe_rom"
                 "-optl-Wl,--export=slap_web_inspect_patch" "-optl-Wl,--export=slap_web_analyze_patch"
                 "-optl-Wl,--export=slap_web_check_apply" "-optl-Wl,--export=slap_web_check_undo"
                 "-optl-Wl,--export=slap_web_check_create" "-optl-Wl,--export=slap_web_check_convert"
                 "-optl-Wl,--export=slap_web_apply_patch" "-optl-Wl,--export=slap_web_undo_patch"
                 "-optl-Wl,--export=slap_web_create_patch" "-optl-Wl,--export=slap_web_convert_patch"

executable slap
  import:           shared
  main-is:          Main.hs
  other-modules:    CLI
                  , Archive
                  , Archive.Zip
                  , Paths_slap
  autogen-modules:  Paths_slap
  hs-source-dirs:   app
  ghc-options:      -Wpartial-fields
  extra-libraries:  rusty_slap
  build-depends:
      bytestring           >= 0.11
    , directory            >= 1.3
    , filepath             >= 1.4
    , mmap                 >= 0.5  && < 0.6
    , optparse-applicative  >= 0.16 && < 0.20
    , process              >= 1.6
    , slap:slap-internal
    , text                 >= 2.0

test-suite props
  import:           shared
  type:             exitcode-stdio-1.0
  main-is:          Props.hs
  other-modules:    Props.BPSMetadata
                  , Props.Classify
                  , Props.ClassifyTargetCopy
                  , Props.Contracts
                  , Props.Detection
                  , Props.EBPMetadata
