cabal-version: 3.0
name:          slap
version:       0.1.0.0
synopsis:      Multi-format ROM patching tool
description:
  Auto-detects patch format from magic bytes and applies.  Starting
  with PPF — more formats to follow.

license:       MIT
license-file:  LICENSE
author:        nyuu
build-type:    Simple

executable slap
  main-is:          Main.hs
  hs-source-dirs:   src
  default-language: GHC2024
  ghc-options:      -Wall -O2
  build-depends:
      base         >= 4.18 && < 5
    , bytestring   >= 0.11
