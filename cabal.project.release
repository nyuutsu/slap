-- The release flavor, read only via --project-file=cabal.project.release; the release rig is its one customer.
-- The import brings the shared truths, and the overrides are what make it a release.

import: cabal.project

optimization: 2

-- GHC keeps the last flag: these cancel the dev flavor's provenance instrumentation,
-- which spends tens of megabytes of binary on naming constructors in crash backtraces.
package slap
  ghc-options: -fno-info-table-map -fno-distinct-constructor-tables

-- Hackage-sourced dependencies compile section-split, so the linker can drop their unreachable code.
-- GHC's boot libraries arrive precompiled and sit beyond this stanza's reach; darwin ignores the flag with a warning.
package *
  ghc-options: -split-sections
