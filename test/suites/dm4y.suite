# Yu-Gi-Oh! Duel Monsters 4: Yuugi Deck (Japan) — dm4-hacking translation
# 4 MB GBC ROM. Primary small-ROM test fixture: 15 format patches,
# exercises CLI behavior, failure modes, and format coverage.
#
# NINJA1: wire format cross-validated against ninja-1.01php. PHP's
# encoder special-cases only {raw, snes, mega, gb} — it can't emit a
# patch flagged as GBC. Both encoders were run in raw mode for the
# four-quadrant cross-apply, then slap rebuilt the fixture with
# --rom-type gbc (single-byte diff at header byte 8: 0x00 → 0x05).
#
# NINJA2: wire format cross-validated against ninja-2.0 PHP reference
# in mode 1 (UTF-8). NINJA2 has no GBC slot — slap maps GBC to raw
# with a warning, so the rom-type byte stays at 0x00 (raw); cross-
# validation was run with both encoders in raw mode.
#
# PPF1: slap-encoded; cross-applied through ApplyPPF Version 1.0 by Icarus/Paradox.
# The 1999 C source needs `-m32` to match the spec's 4-byte LE offset field;
# the unmodified source uses `long`, which on 64-bit Linux silently emits 8-byte offsets.
# Both apply paths produce the canonical target SHA.
#
# PPF2: slap-encoded; cross-validated against Make-PPF v2.0 and Apply-PPF v2.0 by Icarus/Paradox, run via DOSBox.
# slap and the reference binaries can each encode and apply, and every create × apply combination produces the canonical target.
#
# xdelta1: slap-encoded; cross-validated against xdelta 1.1.4.

base:   test/data/dm4y/base.gbc
sha1:   b460119b0fbd80cecba3ded57fa11a16370dd43e
desc:   dm4y translation (4 MB GBC, 15 formats)

BPS      | test/data/dm4y/patch.bps       | real | slap
IPS      | test/data/dm4y/patch.ips       | real | slap
IPS32    | test/data/dm4y/patch.ips32     | real | slap
UPS      | test/data/dm4y/patch.ups       | real | slap
PPF1     | test/data/dm4y/patch.ppf1      | real | slap
PPF2     | test/data/dm4y/patch.ppf2      | real | slap
PPF3     | test/data/dm4y/patch.ppf       | real | slap
EBP      | test/data/dm4y/patch.ebp       | real | slap
APS-N64  | test/data/dm4y/patch.aps       | real | slap
NINJA1   | test/data/dm4y/patch.ninja1    | real | slap
NINJA2   | test/data/dm4y/patch.rup       | real | slap
GDIFF    | test/data/dm4y/patch.gdiff     | real | slap
# VCDIFF mid-reimplementation: apply is stubbed; row returns with the rebuilt family.
# VCDIFF   | test/data/dm4y/patch.vcdiff    | real | xdelta3 -S none
bsdiff   | test/data/dm4y/patch.bsdiff    | real | bsdiff
xdelta1  | test/data/dm4y/patch.xdelta1   | real | slap
